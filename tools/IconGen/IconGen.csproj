<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders every app icon (ICO for the executables, SVG/PNG for the website) from src/Shared/UI/Brand.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Shared\UI\Brand.cs" Link="Brand.cs" />
  </ItemGroup>
</Project>
