<ui:OddWindow x:Class="OddJobs.Scrub.MainWindow"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="clr-namespace:OddJobs.UI"
              Title="Scrub" Width="1220" Height="780" MinWidth="940" MinHeight="580">
    <DockPanel>
        <ui:AppHeader DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
                <Button Content="Add photos" ui:Look.Icon="&#xE710;" Click="AddPhotos_Click" Margin="0,0,8,0" />
                <Button Content="Add folder" ui:Look.Icon="&#xE8B7;" Click="AddFolder_Click" />
            </StackPanel>
        </ui:AppHeader>

        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="OpenOutputButton" Content="Open folder" ui:Look.Icon="&#xE838;" Margin="0,0,8,0" Click="OpenOutput_Click" Visibility="Collapsed" />
                    <Button x:Name="CleanButton" Style="{StaticResource PrimaryButton}" MinWidth="160" Content="Clean photos" Click="Clean_Click" IsEnabled="False" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Style="{StaticResource StatusDot}" Fill="{DynamicResource TextFaint}" />
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="390" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Margin="20,14,16,8">
                    <Button x:Name="ClearButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Clear list" Click="Clear_Click" />
                    <StackPanel>
                        <TextBlock x:Name="CountText" Style="{StaticResource H2}" Text="No photos yet" />
                        <TextBlock x:Name="CountDetail" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>

                <ListBox x:Name="List" Grid.Row="1" Margin="10,0,10,0" SelectionChanged="List_SelectionChanged" KeyDown="List_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="46" Height="46">
                                    <Rectangle RadiusX="6" RadiusY="6" Fill="{DynamicResource Surface2}" />
                                    <Rectangle RadiusX="6" RadiusY="6">
                                        <Rectangle.Fill>
                                            <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="14,1,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <ItemsControl ItemsSource="{Binding Tags}" Margin="0,5,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="P" Style="{StaticResource Pill}" Margin="0,0,5,2">
                                                    <TextBlock x:Name="T" Text="{Binding Text}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                        <Setter TargetName="P" Property="Background" Value="{DynamicResource DangerSoft}" />
                                                        <Setter TargetName="T" Property="Foreground" Value="{DynamicResource Danger}" />
                                                        <Setter TargetName="T" Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsGood}" Value="True">
                                                        <Setter TargetName="P" Property="Background" Value="{DynamicResource SuccessSoft}" />
                                                        <Setter TargetName="T" Property="Foreground" Value="{DynamicResource Success}" />
                                                        <Setter TargetName="T" Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding StateText}" Foreground="{DynamicResource TextFaint}" FontSize="12" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ContentControl x:Name="EmptyState" Grid.Row="1" Style="{StaticResource DropZone}" Margin="20,0,16,16">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="440">
                        <ui:GlyphTile Width="44" Height="44" HorizontalAlignment="Center" />
                        <TextBlock Text="Drop photos here before you share them" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                        <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,6,0,0" LineHeight="19"
                                   Text="Phone photos usually carry the exact spot they were taken, the device, and the time. Scrub shows you what's in them and saves clean copies with nothing but the picture." />
                    </StackPanel>
                </ContentControl>

                <!-- Options -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,12,16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="Save clean copies" />
                            <ComboBox x:Name="DestinationBox" SelectedIndex="0">
                                <ComboBoxItem Content="In a “Cleaned” folder beside them" />
                                <ComboBoxItem Content="In a folder I choose…" />
                                <ComboBoxItem Content="Replace the originals" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Label}" Text="Size" />
                            <ComboBox x:Name="SizeBox" SelectedIndex="0">
                                <ComboBoxItem Content="Keep original" Tag="0" />
                                <ComboBoxItem Content="3840 px (4K)" Tag="3840" />
                                <ComboBoxItem Content="2560 px" Tag="2560" />
                                <ComboBoxItem Content="1920 px (Full HD)" Tag="1920" />
                                <ComboBoxItem Content="1280 px (email)" Tag="1280" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock x:Name="QualityText" DockPanel.Dock="Right" Foreground="{DynamicResource TextMuted}" FontSize="12" Text="90" />
                                <TextBlock Style="{StaticResource Label}" Text="JPEG quality" Margin="0" />
                            </DockPanel>
                            <Slider x:Name="QualitySlider" Minimum="50" Maximum="100" Value="90" SmallChange="1" LargeChange="5" Margin="0,5,0,0"
                                    IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Quality_Changed" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Details -->
            <Border Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <Grid Margin="20,18,20,20">
                        <StackPanel x:Name="Details" Visibility="Collapsed">
                            <Grid Height="230">
                                <Rectangle RadiusX="8" RadiusY="8" Fill="{DynamicResource Surface}" Stroke="{DynamicResource Border}" />
                                <Image x:Name="PreviewImage" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                            <TextBlock x:Name="DetailName" Style="{StaticResource H2}" Margin="0,14,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailSize" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" />

                            <Border x:Name="Verdict" CornerRadius="6" Padding="12,10" Margin="0,16,0,0">
                                <TextBlock x:Name="VerdictText" TextWrapping="Wrap" LineHeight="18" />
                            </Border>

                            <TextBlock Style="{StaticResource Label}" Text="What this photo gives away" Margin="0,18,0,8" />
                            <Grid x:Name="Facts" />
                        </StackPanel>
                        <TextBlock x:Name="DetailsHint" Style="{StaticResource Faint}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="0,200,0,0"
                                   Text="Select a photo to see what's hidden inside it." />
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</ui:OddWindow>
