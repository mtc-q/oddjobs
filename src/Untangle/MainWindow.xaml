<ui:OddWindow x:Class="OddJobs.Untangle.MainWindow"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="clr-namespace:OddJobs.UI"
              xmlns:local="clr-namespace:OddJobs.Untangle"
              Title="Untangle" Width="1280" Height="800" MinWidth="980" MinHeight="580">
    <Window.Resources>
        <Style x:Key="Param" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="ParamCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="ParamCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,8,14,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <DataTemplate DataType="{x:Type local:DedupeStep}">
            <CheckBox Style="{StaticResource ParamCheck}" Content="Ignore capitals" IsChecked="{Binding IgnoreCase}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:SortStep}">
            <ComboBox Style="{StaticResource ParamCombo}" ItemsSource="{x:Static local:SortStep.Modes}" SelectedIndex="{Binding Mode}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:CaseStep}">
            <ComboBox Style="{StaticResource ParamCombo}" ItemsSource="{x:Static local:CaseStep.Modes}" SelectedIndex="{Binding Mode}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:ExtractStep}">
            <ComboBox Style="{StaticResource ParamCombo}" ItemsSource="{x:Static local:ExtractStep.Modes}" SelectedIndex="{Binding Mode}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:ReplaceStep}">
            <StackPanel>
                <TextBox Style="{StaticResource Param}" Text="{Binding Find, UpdateSourceTrigger=PropertyChanged}" ui:Look.Placeholder="Find" />
                <TextBox Style="{StaticResource Param}" Text="{Binding Replace, UpdateSourceTrigger=PropertyChanged}" ui:Look.Placeholder="Replace with (empty removes it)" />
                <WrapPanel>
                    <CheckBox Style="{StaticResource ParamCheck}" Content="Regular expression" IsChecked="{Binding UseRegex}" />
                    <CheckBox Style="{StaticResource ParamCheck}" Content="Match case" IsChecked="{Binding MatchCase}" />
                </WrapPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:FilterStep}">
            <StackPanel>
                <ComboBox Style="{StaticResource ParamCombo}" ItemsSource="{x:Static local:FilterStep.Modes}" SelectedIndex="{Binding Mode}" />
                <TextBox Style="{StaticResource Param}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" ui:Look.Placeholder="Text to look for" />
                <CheckBox Style="{StaticResource ParamCheck}" Content="Match case" IsChecked="{Binding MatchCase}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:AffixStep}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBox Style="{StaticResource Param}" Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" ui:Look.Placeholder="Before" />
                <TextBox Grid.Column="2" Style="{StaticResource Param}" Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" ui:Look.Placeholder="After" />
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:NumberStep}">
            <TextBox Style="{StaticResource Param}" Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" ToolTip="The 1 is replaced by the line number, e.g. “1) ” or “#1 ”" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:JoinStep}">
            <TextBox Style="{StaticResource Param}" Text="{Binding Separator, UpdateSourceTrigger=PropertyChanged}" ui:Look.Placeholder="Separator" ToolTip="Type \t for a tab" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:SplitStep}">
            <TextBox Style="{StaticResource Param}" Text="{Binding Separator, UpdateSourceTrigger=PropertyChanged}" ui:Look.Placeholder="Separator" ToolTip="Type \t for a tab" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:Step}" />
    </Window.Resources>

    <DockPanel>
        <ui:AppHeader DockPanel.Dock="Top">
            <Button x:Name="RecipeButton" Content="Recipes" ui:Look.Icon="&#xE8FD;" Click="Recipes_Click" />
        </ui:AppHeader>

        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" MinWidth="140" ui:Look.Icon="&#xE8C8;" Content="Copy result" Click="Copy_Click" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Style="{StaticResource StatusDot}" Fill="{DynamicResource TextFaint}" />
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Steps -->
            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="20,16,14,10">
                        <Button DockPanel.Dock="Right" Content="Add step" ui:Look.Icon="&#xE710;" Click="AddStep_Click" MinHeight="30" />
                        <TextBlock Style="{StaticResource H2}" Text="Steps" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel Margin="14,0,14,20">
                            <ItemsControl x:Name="StepList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Card" Style="{StaticResource Card}" Padding="12,10,8,12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,-3,0,0">
                                                        <Button Style="{StaticResource SmallIconButton}" ui:Look.Icon="&#xE70E;" FontSize="10" ToolTip="Move up" Click="StepUp_Click" Tag="{Binding}" />
                                                        <Button Style="{StaticResource SmallIconButton}" ui:Look.Icon="&#xE70D;" FontSize="10" ToolTip="Move down" Click="StepDown_Click" Tag="{Binding}" />
                                                        <Button Style="{StaticResource SmallIconButton}" ui:Look.Icon="&#xE711;" FontSize="10" ToolTip="Remove step" Click="StepRemove_Click" Tag="{Binding}" />
                                                    </StackPanel>
                                                    <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    </CheckBox>
                                                </DockPanel>
                                                <StackPanel x:Name="Body" Margin="26,0,6,0">
                                                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="16" />
                                                    <ContentPresenter Content="{Binding}" />
                                                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                                               Visibility="{Binding Error, Converter={x:Static ui:VisibleWhen.Instance}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                <Setter TargetName="Body" Property="Opacity" Value="0.45" />
                                                <Setter TargetName="Card" Property="Background" Value="Transparent" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoSteps" Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="6,4,6,0" LineHeight="17"
                                       Text="No steps yet. Add one, or start from a recipe in the top right." />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Input -->
            <DockPanel Grid.Column="1" Margin="18,14,8,14">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Content="Paste" ui:Look.Icon="&#xE77F;" Click="Paste_Click" MinHeight="30" />
                        <Button Style="{StaticResource GhostButton}" Content="Open…" Click="Open_Click" MinHeight="30" />
                        <Button Style="{StaticResource GhostButton}" Content="Clear" Click="ClearInput_Click" MinHeight="30" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Messy text" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock x:Name="InputStats" DockPanel.Dock="Bottom" Style="{StaticResource Faint}" Margin="2,8,0,0" />
                <TextBox x:Name="Input" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="10,8"
                         VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" FontSize="13"
                         ui:Look.Placeholder="Paste or drop text here" TextChanged="Input_TextChanged" />
            </DockPanel>

            <GridSplitter Grid.Column="2" HorizontalAlignment="Stretch" Margin="0,14" />

            <!-- Output -->
            <DockPanel Grid.Column="3" Margin="8,14,20,14">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Content="Use as input" ui:Look.Icon="&#xE72B;" Click="UseAsInput_Click" MinHeight="30"
                                ToolTip="Move the result to the left and keep going" />
                        <Button Style="{StaticResource GhostButton}" Content="Save…" Click="Save_Click" MinHeight="30" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Clean result" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock x:Name="OutputStats" DockPanel.Dock="Bottom" Style="{StaticResource Faint}" Margin="2,8,0,0" />
                <TextBox x:Name="Output" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="10,8"
                         VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" FontSize="13" Background="{DynamicResource Bg}" />
            </DockPanel>
        </Grid>
    </DockPanel>
</ui:OddWindow>
