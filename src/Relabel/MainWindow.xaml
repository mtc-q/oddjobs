<ui:OddWindow x:Class="OddJobs.Relabel.MainWindow"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="clr-namespace:OddJobs.UI"
              Title="Relabel" Width="1200" Height="760" MinWidth="920" MinHeight="580">
    <Window.Resources>
        <Style x:Key="Token" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,6,6,0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <ui:AppHeader DockPanel.Dock="Top">
            <Button x:Name="UndoButton" Style="{StaticResource GhostButton}" ui:Look.Icon="&#xE7A7;" Content="Undo last rename" Click="Undo_Click" />
        </ui:AppHeader>

        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <Button x:Name="RenameButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" MinWidth="150" Content="Rename" Click="Rename_Click" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Style="{StaticResource StatusDot}" Fill="{DynamicResource TextFaint}" />
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Rules -->
            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="20,18,20,24">
                        <TextBlock Style="{StaticResource Label}" Text="New name" />
                        <TextBox x:Name="TemplateBox" FontFamily="{StaticResource MonoFont}" ui:Look.Placeholder="{}{name}" />
                        <WrapPanel>
                            <Button Style="{StaticResource Token}" Content="{}{name}" Tag="{}{name}" Click="Token_Click" ToolTip="The current name, after find and replace" />
                            <Button Style="{StaticResource Token}" Content="{}{n:3}" Tag="{}{n:3}" Click="Token_Click" ToolTip="A counter, padded to 3 digits: 001, 002, 003…" />
                            <Button Style="{StaticResource Token}" Content="{}{taken}" Tag="{}{taken}" Click="Token_Click" ToolTip="The date a photo was taken (falls back to date modified)" />
                            <Button Style="{StaticResource Token}" Content="{}{date}" Tag="{}{date}" Click="Token_Click" ToolTip="Date modified, as yyyy-MM-dd" />
                            <Button Style="{StaticResource Token}" Content="{}{folder}" Tag="{}{folder}" Click="Token_Click" ToolTip="Name of the folder the file is in" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="17"
                                   Text="Dates take any format, e.g. {taken:yyyy-MM-dd HH.mm}. The extension is kept automatically." />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}" Text="Counter starts at" />
                                <TextBox x:Name="StartBox" Text="1" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Label}" Text="Counter step" />
                                <TextBox x:Name="StepBox" Text="1" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,20" />

                        <TextBlock Style="{StaticResource Label}" Text="Find" />
                        <TextBox x:Name="FindBox" FontFamily="{StaticResource MonoFont}" ui:Look.Placeholder="Text to look for in each name" />
                        <TextBlock Style="{StaticResource Label}" Text="Replace with" Margin="0,10,0,6" />
                        <TextBox x:Name="ReplaceBox" FontFamily="{StaticResource MonoFont}" ui:Look.Placeholder="Leave empty to remove it" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <CheckBox x:Name="RegexBox" Content="Regular expression" Margin="0,0,18,0" />
                            <CheckBox x:Name="MatchCaseBox" Content="Match case" />
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" Margin="0,20" />

                        <TextBlock Style="{StaticResource Label}" Text="Capitalisation" />
                        <ComboBox x:Name="CaseBox" SelectedIndex="0">
                            <ComboBoxItem Content="Keep as it is" />
                            <ComboBoxItem Content="lowercase" />
                            <ComboBoxItem Content="UPPERCASE" />
                            <ComboBoxItem Content="Title Case" />
                            <ComboBoxItem Content="Sentence case" />
                        </ComboBox>

                        <TextBlock Style="{StaticResource Label}" Text="Spaces" Margin="0,14,0,6" />
                        <Border Style="{StaticResource SegmentBar}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="SpaceKeep" Style="{StaticResource Segment}" GroupName="sp" Content="Keep" IsChecked="True" />
                                <RadioButton x:Name="SpaceDash" Style="{StaticResource Segment}" GroupName="sp" Content="a-b" />
                                <RadioButton x:Name="SpaceUnderscore" Style="{StaticResource Segment}" GroupName="sp" Content="a__b" />
                                <RadioButton x:Name="SpaceRemove" Style="{StaticResource Segment}" GroupName="sp" Content="ab" />
                            </StackPanel>
                        </Border>
                        <CheckBox x:Name="TrimBox" Content="Tidy extra spaces" IsChecked="True" Margin="0,10,0,0"
                                  ToolTip="Removes spaces at the start and end, and turns double spaces into single ones" />

                        <TextBlock Style="{StaticResource Label}" Text="Extension" Margin="0,14,0,6" />
                        <Border Style="{StaticResource SegmentBar}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ExtKeep" Style="{StaticResource Segment}" GroupName="ext" Content="Keep" IsChecked="True" />
                                <RadioButton x:Name="ExtLower" Style="{StaticResource Segment}" GroupName="ext" Content=".jpg" />
                                <RadioButton x:Name="ExtUpper" Style="{StaticResource Segment}" GroupName="ext" Content=".JPG" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Divider}" Margin="0,20" />

                        <TextBlock Style="{StaticResource Label}" Text="Number the files in this order" />
                        <ComboBox x:Name="OrderBox" SelectedIndex="0">
                            <ComboBoxItem Content="Name" />
                            <ComboBoxItem Content="Date modified" />
                            <ComboBoxItem Content="Date taken (photos)" />
                            <ComboBoxItem Content="Size" />
                            <ComboBoxItem Content="Order added" />
                        </ComboBox>
                        <CheckBox x:Name="DescendingBox" Content="Reverse order" Margin="0,10,0,0" />

                        <Button Style="{StaticResource GhostButton}" Content="Reset all rules" ui:Look.Icon="&#xE72C;" HorizontalAlignment="Left"
                                Margin="-10,18,0,0" Click="Reset_Click" Foreground="{DynamicResource TextMuted}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Files -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Margin="20,14,16,10">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <CheckBox x:Name="SubfoldersBox" Content="Include subfolders" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <Button Content="Add files" ui:Look.Icon="&#xE710;" Click="AddFiles_Click" Margin="0,0,8,0" />
                        <Button Content="Add folder" ui:Look.Icon="&#xE8B7;" Click="AddFolder_Click" Margin="0,0,8,0" />
                        <Button x:Name="ClearButton" Style="{StaticResource GhostButton}" Content="Clear" Click="Clear_Click" />
                    </StackPanel>
                    <TextBlock x:Name="CountText" Style="{StaticResource H2}" VerticalAlignment="Center" Text="No files yet" />
                </DockPanel>

                <ListView x:Name="List" Grid.Row="1" Margin="12,0,12,0" SelectionMode="Extended" KeyDown="List_KeyDown"
                          MouseDoubleClick="List_DoubleClick">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Remove from list" InputGestureText="Del" Click="Remove_Click" />
                            <MenuItem Header="Show in Explorer" Click="Reveal_Click" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Current name" Width="290">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="30">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="&#xE72A;" Style="{StaticResource Glyph}" FontSize="11" Foreground="{DynamicResource TextFaint}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="New name" Width="300">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="T" Text="{Binding NewName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTip="{Binding NewName}" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsChanged}" Value="False">
                                                <Setter TargetName="T" Property="Foreground" Value="{DynamicResource TextFaint}" />
                                                <Setter TargetName="T" Property="FontWeight" Value="Normal" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Problem">
                                                <Setter TargetName="T" Property="Foreground" Value="{DynamicResource Danger}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Status" Width="220">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="Dot" Style="{StaticResource StatusDot}" Width="7" Height="7" Fill="{DynamicResource TextFaint}" />
                                            <TextBlock x:Name="N" Text="{Binding Note}" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Ready">
                                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Accent}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Problem">
                                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Danger}" />
                                                <Setter TargetName="N" Property="Foreground" Value="{DynamicResource Danger}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Done">
                                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Success}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Failed">
                                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Danger}" />
                                                <Setter TargetName="N" Property="Foreground" Value="{DynamicResource Danger}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Folder" Width="170">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FolderName}" Foreground="{DynamicResource TextFaint}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <ContentControl x:Name="EmptyState" Grid.Row="1" Style="{StaticResource DropZone}" Margin="20,0,20,20">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="28" HorizontalAlignment="Center" Foreground="{DynamicResource TextFaint}" />
                        <TextBlock Text="Drop files or folders here" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,6,0,0" LineHeight="19"
                                   Text="Nothing is renamed until you press Rename. Every change shows up here first, and the last batch can always be undone." />
                    </StackPanel>
                </ContentControl>
            </Grid>
        </Grid>
    </DockPanel>
</ui:OddWindow>
