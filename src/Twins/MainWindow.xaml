<ui:OddWindow x:Class="OddJobs.Twins.MainWindow"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="clr-namespace:OddJobs.UI"
              xmlns:local="clr-namespace:OddJobs.Twins"
              Title="Twins" Width="1240" Height="780" MinWidth="960" MinHeight="580">
    <Window.Resources>
        <DataTemplate DataType="{x:Type local:GroupRow}">
            <DockPanel Margin="2,16,2,6">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Bottom" />
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:FileRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding Marked}" VerticalAlignment="Center" ToolTip="Move this copy to the Recycle Bin" />
                <StackPanel Grid.Column="1" Margin="12,0,12,0">
                    <TextBlock x:Name="N" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding FolderShort}" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" ToolTip="{Binding Folder}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" Style="{StaticResource Faint}" VerticalAlignment="Center" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Marked}" Value="True">
                    <Setter TargetName="N" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="N" Property="Foreground" Value="{DynamicResource Danger}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="RowContainer" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="10,7" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                    <Setter Property="IsHitTestVisible" Value="False" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Padding" Value="8,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <ui:AppHeader DockPanel.Dock="Top" />

        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <Button x:Name="RecycleButton" DockPanel.Dock="Right" Style="{StaticResource DangerButton}" MinWidth="170"
                        ui:Look.Icon="&#xE74D;" Content="Move to Recycle Bin" Click="Recycle_Click" IsEnabled="False" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Style="{StaticResource StatusDot}" Fill="{DynamicResource TextFaint}" />
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="PreviewColumn" Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Search options -->
            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="20,18,20,24">
                        <TextBlock Style="{StaticResource Label}" Text="Look in these folders" />
                        <ItemsControl x:Name="FolderList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Margin="0,0,0,6" Padding="10,4,4,4">
                                        <DockPanel ToolTip="{Binding}">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButton}" ui:Look.Icon="&#xE711;" FontSize="10"
                                                    ToolTip="Remove" Click="RemoveFolder_Click" Tag="{Binding}" VerticalAlignment="Center" />
                                            <StackPanel VerticalAlignment="Center" Margin="0,2">
                                                <TextBlock Text="{Binding Converter={x:Static ui:PathParts.Name}}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Converter={x:Static ui:PathParts.Parent}}" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Add a folder" ui:Look.Icon="&#xE710;" HorizontalAlignment="Stretch" Click="AddFolder_Click" />
                        <TextBlock Style="{StaticResource Faint}" Text="Tip: drop folders anywhere on this window." Margin="0,8,0,0" />

                        <Border Style="{StaticResource Divider}" Margin="0,20" />

                        <TextBlock Style="{StaticResource Label}" Text="Only look at" />
                        <ComboBox x:Name="KindBox" SelectedIndex="0">
                            <ComboBoxItem Content="All files" />
                            <ComboBoxItem Content="Images" />
                            <ComboBoxItem Content="Videos" />
                            <ComboBoxItem Content="Music and audio" />
                            <ComboBoxItem Content="Documents" />
                            <ComboBoxItem Content="Archives" />
                            <ComboBoxItem Content="Installers" />
                        </ComboBox>

                        <TextBlock Style="{StaticResource Label}" Text="Skip files smaller than" Margin="0,14,0,6" />
                        <ComboBox x:Name="MinSizeBox" SelectedIndex="1">
                            <ComboBoxItem Content="Nothing (include tiny files)" Tag="1" />
                            <ComboBoxItem Content="10 KB" Tag="10240" />
                            <ComboBoxItem Content="100 KB" Tag="102400" />
                            <ComboBoxItem Content="1 MB" Tag="1048576" />
                            <ComboBoxItem Content="10 MB" Tag="10485760" />
                            <ComboBoxItem Content="100 MB" Tag="104857600" />
                        </ComboBox>

                        <CheckBox x:Name="HiddenBox" Content="Include hidden and system files" Margin="0,14,0,0" />

                        <Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}" Content="Find duplicates" HorizontalAlignment="Stretch"
                                Margin="0,22,0,0" MinHeight="36" Click="Scan_Click" />

                        <StackPanel x:Name="ProgressPanel" Margin="0,16,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="PhaseText" FontWeight="SemiBold" />
                            <ProgressBar x:Name="Progress" Margin="0,8,0,8" IsIndeterminate="True" />
                            <TextBlock x:Name="DetailText" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" LineHeight="17" Margin="0,22,0,0"
                                   Text="Files only count as duplicates when every byte matches (SHA-256), whatever their names. Twins only reads files. Online-only OneDrive files are skipped so nothing gets downloaded." />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Results -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="20,16,20,8">
                    <TextBlock x:Name="SummaryText" Style="{StaticResource H2}" Text="No search yet" />
                    <TextBlock x:Name="SummaryDetail" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                    <WrapPanel x:Name="SelectBar" Margin="0,12,0,0" Visibility="Collapsed">
                        <TextBlock Text="Select" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Content="All but newest" Margin="0,0,6,6" Click="KeepNewest_Click" ToolTip="In every set, keep the most recently modified copy" />
                        <Button Content="All but oldest" Margin="0,0,6,6" Click="KeepOldest_Click" ToolTip="In every set, keep the original (oldest) copy" />
                        <Button Content="Outside a folder…" Margin="0,0,6,6" Click="KeepFolder_Click" ToolTip="Keep copies inside a folder you pick, select the others" />
                        <Button Style="{StaticResource GhostButton}" Content="Clear" Margin="0,0,6,6" Click="ClearMarks_Click" />
                    </WrapPanel>
                </StackPanel>

                <ListBox x:Name="Results" Grid.Row="1" Margin="10,0,10,0" ItemContainerStyle="{StaticResource RowContainer}"
                         SelectionChanged="Results_SelectionChanged" KeyDown="Results_KeyDown" MouseDoubleClick="Results_DoubleClick"
                         VirtualizingPanel.ScrollUnit="Pixel" />

                <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380" Margin="0,0,0,60">
                    <ui:GlyphTile Width="44" Height="44" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyTitle" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,16,0,0" Text="Find files you have more than once" />
                    <TextBlock x:Name="EmptyBody" Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,6,0,0" LineHeight="19"
                               Text="Add the folders to search, then press Find duplicates. Nothing is removed until you choose which copies to let go." />
                </StackPanel>
            </Grid>

            <!-- Preview -->
            <Border Grid.Column="2" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                <Grid Margin="18">
                    <StackPanel x:Name="PreviewPanel" Visibility="Collapsed">
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Height="200" ClipToBounds="True">
                            <Grid>
                                <TextBlock x:Name="PreviewGlyph" Text="&#xE8A5;" Style="{StaticResource Glyph}" FontSize="32" HorizontalAlignment="Center" Foreground="{DynamicResource TextFaint}" />
                                <Image x:Name="PreviewImage" Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="PreviewName" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,14,0,0" />
                        <TextBlock x:Name="PreviewFolder" Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="12" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Size" Style="{StaticResource Faint}" Margin="0,0,16,6" />
                            <TextBlock x:Name="PreviewSize" Grid.Column="1" />
                            <TextBlock Grid.Row="1" Text="Modified" Style="{StaticResource Faint}" Margin="0,0,16,6" />
                            <TextBlock x:Name="PreviewDate" Grid.Row="1" Grid.Column="1" />
                            <TextBlock Grid.Row="2" Text="SHA-256" Style="{StaticResource Faint}" Margin="0,0,16,0" />
                            <TextBlock x:Name="PreviewHash" Grid.Row="2" Grid.Column="1" Style="{StaticResource Mono}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="Show in Explorer" ui:Look.Icon="&#xE838;" Click="Reveal_Click" Margin="0,0,8,0" />
                            <Button Content="Open" Click="Open_Click" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="PreviewHint" Style="{StaticResource Faint}" TextWrapping="Wrap" VerticalAlignment="Center" TextAlignment="Center"
                               Text="Select a file to preview it here." />
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</ui:OddWindow>
