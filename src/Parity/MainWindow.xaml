<ui:OddWindow x:Class="OddJobs.Parity.MainWindow"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="clr-namespace:OddJobs.UI"
              Title="Parity" Width="1240" Height="780" MinWidth="960" MinHeight="580">
    <Window.Resources>
        <Style x:Key="FolderCard" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="ui:Look.CornerRadius" Value="8" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <ui:AppHeader DockPanel.Dock="Top" />

        <!-- Folders -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource FolderCard}" Click="PickLeft_Click">
                    <StackPanel>
                        <TextBlock Text="Left, usually the original" Style="{StaticResource Faint}" FontSize="11" />
                        <TextBlock x:Name="LeftName" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Text="Choose a folder" />
                        <TextBlock x:Name="LeftPath" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" ui:Look.Icon="&#xE8AB;" Margin="8,0" ToolTip="Swap left and right" Click="Swap_Click" />
                <Button Grid.Column="2" Style="{StaticResource FolderCard}" Click="PickRight_Click">
                    <StackPanel>
                        <TextBlock Text="Right, usually the backup" Style="{StaticResource Faint}" FontSize="11" />
                        <TextBlock x:Name="RightName" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Text="Choose a folder" />
                        <TextBlock x:Name="RightPath" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="CompareButton" Style="{StaticResource PrimaryButton}" Content="Compare" MinWidth="120" Click="Compare_Click" />
                    <CheckBox x:Name="ContentsBox" Content="Compare contents" FontSize="12" Margin="0,8,0,0"
                              ToolTip="Reads both copies of every same-sized file. Slower, but catches files that changed without their date changing." />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ComboBox x:Name="ModeBox" Width="300" Margin="0,0,10,0" SelectedIndex="0" SelectionChanged="Mode_Changed">
                        <ComboBoxItem Content="Update the right side (left → right)" />
                        <ComboBoxItem Content="Sync both ways (newest wins)" />
                        <ComboBoxItem Content="Make the right an exact copy of the left" />
                    </ComboBox>
                    <Button x:Name="SyncButton" Style="{StaticResource PrimaryButton}" MinWidth="150" Content="Sync" Click="Sync_Click" IsEnabled="False" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Style="{StaticResource StatusDot}" Fill="{DynamicResource TextFaint}" />
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <WrapPanel x:Name="Filters" Margin="20,14,20,8" Visibility="Collapsed">
                <ToggleButton x:Name="FilterLeft" Style="{StaticResource Chip}" IsChecked="True" Click="Filter_Click" Margin="0,0,6,6" />
                <ToggleButton x:Name="FilterChanged" Style="{StaticResource Chip}" IsChecked="True" Click="Filter_Click" Margin="0,0,6,6" />
                <ToggleButton x:Name="FilterRight" Style="{StaticResource Chip}" IsChecked="True" Click="Filter_Click" Margin="0,0,6,6" />
                <ToggleButton x:Name="FilterSame" Style="{StaticResource Chip}" IsChecked="False" Click="Filter_Click" Margin="0,0,6,6" />
            </WrapPanel>

            <ListView x:Name="List" Grid.Row="1" Margin="12,0,12,0" MouseDoubleClick="List_DoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="36">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding Actionable}" ToolTip="Include in the sync" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="File" Width="300">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Relative}" />
                                        <TextBlock Text="{Binding Folder}" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Difference" Width="170">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="Dot" Style="{StaticResource StatusDot}" Width="7" Height="7" Fill="{DynamicResource TextFaint}" />
                                        <TextBlock Text="{Binding KindText}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="OnlyLeft">
                                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Accent}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="LeftNewer">
                                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="RightNewer">
                                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Different">
                                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Danger}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="OnlyRight">
                                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource TextMuted}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Left" Width="180">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LeftText}" Foreground="{DynamicResource TextMuted}" FontSize="12" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Right" Width="180">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RightText}" Foreground="{DynamicResource TextMuted}" FontSize="12" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Will" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Plan}" FontSize="12" FontWeight="SemiBold" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <StackPanel x:Name="ProgressPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="380" Visibility="Collapsed">
                <TextBlock x:Name="ProgressTitle" Style="{StaticResource H2}" />
                <ProgressBar x:Name="Progress" IsIndeterminate="True" Margin="0,12,0,10" />
                <TextBlock x:Name="ProgressDetail" Style="{StaticResource Muted}" />
                <Button Content="Stop" HorizontalAlignment="Left" Margin="0,14,0,0" Click="Stop_Click" />
            </StackPanel>

            <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Margin="0,0,0,40">
                <ui:GlyphTile Width="44" Height="44" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyTitle" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,16,0,0" Text="Is your backup really up to date?" />
                <TextBlock x:Name="EmptyBody" Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,6,0,0" LineHeight="19"
                           Text="Pick a folder and its copy (a USB drive, a backup disk, another PC). Parity lists what's missing or newer on each side, and copies only that." />
            </StackPanel>
        </Grid>
    </DockPanel>
</ui:OddWindow>
