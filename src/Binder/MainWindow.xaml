<ui:OddWindow x:Class="OddJobs.Binder.MainWindow"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="clr-namespace:OddJobs.UI"
              Title="Binder" Width="1200" Height="780" MinWidth="900" MinHeight="580">
    <Window.Resources>
        <Style x:Key="PageContainer" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,14,16" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <StackPanel Width="160">
                            <Border x:Name="Frame" Height="196" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent" Padding="4" Background="Transparent">
                                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="3">
                                    <Image Source="{Binding Thumb}" Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.LayoutTransform>
                                            <RotateTransform Angle="{Binding Rotation}" />
                                        </Image.LayoutTransform>
                                    </Image>
                                </Border>
                            </Border>
                            <TextBlock HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="12">
                                <Run Text="{Binding Number, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{Binding Name, Mode=OneWay}" Foreground="{DynamicResource TextFaint}" />
                            </TextBlock>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Surface2}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource AccentFaint}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <ui:AppHeader DockPanel.Dock="Top">
            <Button Content="Add images" ui:Look.Icon="&#xE710;" Click="Add_Click" />
        </ui:AppHeader>

        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="OpenButton" Content="Open PDF" ui:Look.Icon="&#xE8A5;" Margin="0,0,8,0" Click="OpenPdf_Click" Visibility="Collapsed" />
                    <Button x:Name="CreateButton" Style="{StaticResource PrimaryButton}" MinWidth="150" Content="Create PDF" Click="Create_Click" IsEnabled="False" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Style="{StaticResource StatusDot}" Fill="{DynamicResource TextFaint}" />
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="20,14,16,10">
                    <StackPanel x:Name="PageTools" DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="False">
                        <Button Style="{StaticResource IconButton}" ui:Look.Icon="&#xE76B;" ToolTip="Move earlier" Click="MoveLeft_Click" />
                        <Button Style="{StaticResource IconButton}" ui:Look.Icon="&#xE76C;" ToolTip="Move later" Click="MoveRight_Click" />
                        <Button Style="{StaticResource IconButton}" ui:Look.Icon="&#xE7AD;" ToolTip="Rotate right" Click="RotateRight_Click" />
                        <Button Style="{StaticResource IconButton}" ui:Look.Icon="&#xE74D;" ToolTip="Remove page" Click="Remove_Click" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="CountText" Style="{StaticResource H2}" Text="No pages yet" />
                        <TextBlock Style="{StaticResource Faint}" Text="Drag pages to put them in order." Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>

                <ListBox x:Name="Pages" Grid.Row="1" Margin="16,0,8,0" Padding="4,0" SelectionMode="Extended" ItemContainerStyle="{StaticResource PageContainer}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Pages_SelectionChanged" KeyDown="Pages_KeyDown"
                         PreviewMouseLeftButtonDown="Pages_PreviewMouseDown" PreviewMouseMove="Pages_PreviewMouseMove" Drop="Pages_Drop" DragOver="Pages_DragOver" AllowDrop="True">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <ContentControl x:Name="EmptyState" Grid.Row="1" Style="{StaticResource DropZone}" Margin="20,0,16,20">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                        <ui:GlyphTile Width="44" Height="44" HorizontalAlignment="Center" />
                        <TextBlock Text="Drop photos or scans here" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                        <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,6,0,0" LineHeight="19"
                                   Text="Receipts, forms, signed pages, whiteboard photos. Binder puts them in one PDF, the right way up, without uploading them anywhere." />
                    </StackPanel>
                </ContentControl>
            </Grid>

            <Border Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="20,18,20,20">
                        <TextBlock Style="{StaticResource Label}" Text="Page size" />
                        <Border Style="{StaticResource SegmentBar}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="SizeA4" Style="{StaticResource Segment}" GroupName="size" Content="A4" IsChecked="True" Checked="Option_Changed" />
                                <RadioButton x:Name="SizeLetter" Style="{StaticResource Segment}" GroupName="size" Content="Letter" Checked="Option_Changed" />
                                <RadioButton x:Name="SizeFit" Style="{StaticResource Segment}" GroupName="size" Content="Same as image" Checked="Option_Changed" />
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="MarginLabel" Style="{StaticResource Label}" Text="Margins" Margin="0,18,0,6" />
                        <Border x:Name="MarginBar" Style="{StaticResource SegmentBar}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="MarginNone" Style="{StaticResource Segment}" GroupName="m" Content="None" Checked="Option_Changed" />
                                <RadioButton x:Name="MarginSmall" Style="{StaticResource Segment}" GroupName="m" Content="Small" IsChecked="True" Checked="Option_Changed" />
                                <RadioButton x:Name="MarginNormal" Style="{StaticResource Segment}" GroupName="m" Content="Normal" Checked="Option_Changed" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Label}" Text="Quality" Margin="0,18,0,6" />
                        <Border Style="{StaticResource SegmentBar}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="QualityBest" Style="{StaticResource Segment}" GroupName="q" Content="Best" IsChecked="True" Checked="Option_Changed" />
                                <RadioButton x:Name="QualityCompact" Style="{StaticResource Segment}" GroupName="q" Content="Smaller file" Checked="Option_Changed" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="QualityHint" Style="{StaticResource Faint}" TextWrapping="Wrap" LineHeight="17" Margin="0,8,0,0" />

                        <Border Style="{StaticResource Divider}" Margin="0,20" />

                        <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" LineHeight="17"
                                   Text="Phone photos are turned the right way up automatically. Location and camera details are left out of the PDF. Use Rotate if a scan is sideways." />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</ui:OddWindow>
