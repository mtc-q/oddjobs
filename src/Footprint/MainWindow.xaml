<ui:OddWindow x:Class="OddJobs.Footprint.MainWindow"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="clr-namespace:OddJobs.UI"
              xmlns:local="clr-namespace:OddJobs.Footprint"
              Title="Footprint" Width="1280" Height="800" MinWidth="980" MinHeight="600">
    <DockPanel>
        <ui:AppHeader DockPanel.Dock="Top">
            <Button Content="Scan a folder…" ui:Look.Icon="&#xE8B7;" Click="PickFolder_Click" />
        </ui:AppHeader>

        <!-- Drives -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="20,12,20,6">
            <ItemsControl x:Name="Drives">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="Drive_Click" Tag="{Binding Root}" Margin="0,0,8,6" Padding="12,8" HorizontalContentAlignment="Stretch" Width="200">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding FreeText}" Foreground="{DynamicResource TextMuted}" FontSize="12" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <Grid Height="4" Margin="0,7,0,0">
                                    <Border Background="{DynamicResource Surface3}" CornerRadius="2" />
                                    <Border Background="{Binding BarBrush}" CornerRadius="2" HorizontalAlignment="Left" Width="{Binding UsedWidth}" />
                                </Grid>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="RevealButton" Content="Show in Explorer" ui:Look.Icon="&#xE838;" Click="Reveal_Click" Margin="0,0,8,0" IsEnabled="False" />
                    <Button x:Name="RecycleButton" Style="{StaticResource DangerButton}" ui:Look.Icon="&#xE74D;" Content="Move to Recycle Bin" Click="Recycle_Click" IsEnabled="False" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Style="{StaticResource StatusDot}" Fill="{DynamicResource TextFaint}" />
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" MinWidth="280" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Breadcrumb -->
            <DockPanel Grid.ColumnSpan="3" Margin="14,10,20,6">
                <Button x:Name="UpButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" ui:Look.Icon="&#xE74A;" ToolTip="Up one folder" Click="Up_Click" IsEnabled="False" />
                <TextBlock x:Name="TotalText" DockPanel.Dock="Right" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                <ItemsControl x:Name="Crumbs" VerticalAlignment="Center" Margin="4,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE76C;" Style="{StaticResource Glyph}" FontSize="9" Foreground="{DynamicResource TextFaint}" Margin="2,0"
                                           Visibility="{Binding ShowChevron, Converter={x:Static ui:VisibleWhen.Instance}}" />
                                <Button Style="{StaticResource GhostButton}" Content="{Binding Name}" Tag="{Binding Node}" Click="Crumb_Click" Padding="6,0" MinHeight="28" FontWeight="SemiBold" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <!-- Folder list -->
            <ListView x:Name="List" Grid.Row="1" Margin="10,0,0,0" SelectionMode="Single"
                      SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_DoubleClick" KeyDown="List_KeyDown">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="190">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Swatch}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="{Binding Weight}" ToolTip="{Binding Node.FullPath}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Size" Width="76">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeText}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Share" Width="96">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="48" Height="4" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource Surface3}" CornerRadius="2" />
                                            <Border Background="{DynamicResource Accent}" CornerRadius="2" HorizontalAlignment="Left" Width="{Binding ShareWidth}" />
                                        </Grid>
                                        <TextBlock Text="{Binding ShareText}" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="8,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Files" Width="64">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FilesText}" Foreground="{DynamicResource TextMuted}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <GridSplitter Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" />

            <!-- Map -->
            <Border Grid.Row="1" Grid.Column="2" Margin="0,0,20,0" CornerRadius="6" ClipToBounds="True">
                <Grid>
                    <local:TreemapView x:Name="Map" />
                    <StackPanel x:Name="ScanPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Width="360" Visibility="Collapsed">
                        <TextBlock x:Name="ScanTitle" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis" />
                        <ProgressBar IsIndeterminate="True" Margin="0,12,0,10" />
                        <TextBlock x:Name="ScanDetail" Style="{StaticResource Muted}" />
                        <TextBlock x:Name="ScanPath" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                        <Button Content="Stop" HorizontalAlignment="Left" Margin="0,14,0,0" Click="Stop_Click" />
                    </StackPanel>
                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400">
                        <ui:GlyphTile Width="44" Height="44" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,16,0,0" Text="Where did all the space go?" />
                        <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,6,0,0" LineHeight="19"
                                   Text="Pick a drive above, or scan a folder. Every box is sized by how much space it takes, so the big ones stand out." />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Legend -->
            <ItemsControl x:Name="Legend" Grid.Row="2" Grid.Column="2" Margin="0,10,20,12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                            <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Swatch}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Label}" Margin="6,0,4,0" FontSize="12" />
                            <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource TextFaint}" FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </DockPanel>
</ui:OddWindow>
