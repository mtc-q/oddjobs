<ui:OddWindow x:Class="OddJobs.Lockbox.MainWindow"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="clr-namespace:OddJobs.UI"
              Title="Lockbox" Width="1080" Height="740" MinWidth="860" MinHeight="580">
    <DockPanel>
        <ui:AppHeader DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
                <Button Content="Add files" ui:Look.Icon="&#xE710;" Click="AddFiles_Click" Margin="0,0,8,0" />
                <Button Content="Add folder" ui:Look.Icon="&#xE8B7;" Click="AddFolder_Click" />
            </StackPanel>
        </ui:AppHeader>

        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <Button x:Name="ClearButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Clear list" Click="Clear_Click" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Style="{StaticResource StatusDot}" Fill="{DynamicResource TextFaint}" />
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="20,16,20,8">
                    <TextBlock x:Name="CountText" Style="{StaticResource H2}" Text="Nothing added yet" />
                    <TextBlock x:Name="CountDetail" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
                <ListBox x:Name="List" Grid.Row="1" Margin="10,0,10,10" KeyDown="List_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="6" Background="{DynamicResource Surface2}">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                    <ProgressBar Margin="0,6,0,0" Maximum="1" Value="{Binding Progress}" Visibility="{Binding Busy, Converter={x:Static ui:VisibleWhen.Instance}}" />
                                </StackPanel>
                                <TextBlock x:Name="State" Grid.Column="2" Text="{Binding StateText}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFaint}" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Good}" Value="True">
                                    <Setter TargetName="State" Property="Foreground" Value="{DynamicResource Success}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Bad}" Value="True">
                                    <Setter TargetName="State" Property="Foreground" Value="{DynamicResource Danger}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ContentControl x:Name="EmptyState" Grid.Row="1" Style="{StaticResource DropZone}" Margin="20,0,20,20">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="440">
                        <ui:GlyphTile Width="44" Height="44" HorizontalAlignment="Center" />
                        <TextBlock Text="Drop files or folders to lock them" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                        <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,6,0,0" LineHeight="19"
                                   Text="Each one becomes a .lockbox file that only opens with your password. Drop .lockbox files here to unlock them. Safe to keep in the cloud, on a USB stick or in an email." />
                    </StackPanel>
                </ContentControl>
            </Grid>

            <Border Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="22,20,22,22">
                        <TextBlock x:Name="ModeTitle" Style="{StaticResource Title}" FontSize="18" Text="Lock" />
                        <TextBlock x:Name="ModeHint" Style="{StaticResource Muted}" Margin="0,4,0,0" LineHeight="19" />

                        <DockPanel Margin="0,18,0,6">
                            <Button x:Name="RevealButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Show" Click="Reveal_Click" FontSize="12" Foreground="{DynamicResource TextMuted}" />
                            <TextBlock Style="{StaticResource Label}" Text="Password" Margin="0" />
                        </DockPanel>
                        <Grid>
                            <PasswordBox x:Name="Password" PasswordChanged="Password_Changed" />
                            <TextBox x:Name="PasswordPlain" Visibility="Collapsed" FontFamily="{StaticResource MonoFont}" MinHeight="34" TextChanged="PasswordPlain_Changed" />
                        </Grid>

                        <StackPanel x:Name="StrengthPanel" Margin="0,8,0,0">
                            <Grid Height="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Bar1" CornerRadius="2" Background="{DynamicResource Surface3}" />
                                <Border x:Name="Bar2" Grid.Column="2" CornerRadius="2" Background="{DynamicResource Surface3}" />
                                <Border x:Name="Bar3" Grid.Column="4" CornerRadius="2" Background="{DynamicResource Surface3}" />
                                <Border x:Name="Bar4" Grid.Column="6" CornerRadius="2" Background="{DynamicResource Surface3}" />
                            </Grid>
                            <DockPanel Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Suggest a strong one" Click="Generate_Click" FontSize="12" />
                                <TextBlock x:Name="StrengthText" FontSize="12" Foreground="{DynamicResource TextFaint}" />
                            </DockPanel>
                        </StackPanel>

                        <StackPanel x:Name="ConfirmPanel">
                            <TextBlock Style="{StaticResource Label}" Text="Type it again" Margin="0,16,0,6" />
                            <PasswordBox x:Name="Confirm" PasswordChanged="Password_Changed" />
                            <TextBlock x:Name="ConfirmText" FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource Danger}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Label}" Text="Save to" Margin="0,16,0,6" />
                        <ComboBox x:Name="DestinationBox" SelectedIndex="0">
                            <ComboBoxItem Content="The same folder as each file" />
                            <ComboBoxItem Content="A folder I choose…" />
                        </ComboBox>

                        <CheckBox x:Name="RecycleBox" Style="{StaticResource Switch}" Margin="0,16,0,0">
                            <TextBlock Text="Move the originals to the Recycle Bin after locking" TextWrapping="Wrap" />
                        </CheckBox>

                        <Button x:Name="GoButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" MinHeight="38" Margin="0,20,0,0"
                                Content="Lock" Click="Go_Click" IsEnabled="False" />

                        <Border CornerRadius="6" Background="{DynamicResource WarningSoft}" Padding="12,10" Margin="0,18,0,0">
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Warning}" FontSize="12" LineHeight="17"
                                       Text="There is no way to recover a forgotten password. Not by us, not by anyone. Keep it somewhere safe, like a password manager." />
                        </Border>
                        <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" LineHeight="17" Margin="0,14,0,0"
                                   Text="AES-256 with a 600,000-round PBKDF2 key, and a tamper check on every byte. The password never leaves this window and is never saved." />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</ui:OddWindow>
